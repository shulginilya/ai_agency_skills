{
  "mcpServers": {
    "example-stdio-server": {
      "command": "npx",
      "args": ["-y", "@example/mcp-server", "--flag"],
      "env": {
        "EXAMPLE_API_KEY": "${EXAMPLE_API_KEY}"
      }
    },
    "example-http-server": {
      "type": "http",
      "url": "https://mcp.example.com/v1",
      "headers": {
        "Authorization": "Bearer ${EXAMPLE_TOKEN}"
      }
    }
  }
}
